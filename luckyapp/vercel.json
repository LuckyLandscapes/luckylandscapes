{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/auto-dunning",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/cleanup-quote-media",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/meta-leads-poll",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/recurring-billing",
      "schedule": "0 13 * * *"
    }
  ]
}
